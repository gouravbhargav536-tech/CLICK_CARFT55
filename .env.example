# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Optional Groq API key for ultra-fast Llama 3 completions.
GROQ_API_KEY=""

# ELEVENLABS_API_KEY: Optional ElevenLabs API key for ultra-realistic Hindi speaker voice (eleven_multilingual_v2)
ELEVENLABS_API_KEY=""

# GOOGLE_TTS_API_KEY / GOOGLE_CLOUD_API_KEY: Google Cloud Text-to-Speech API key for WaveNet voices (hi-IN-Wavenet-A).
# In Netlify's Environment Variables dashboard, you can set GOOGLE_TTS_API_KEY, GOOGLE_CLOUD_API_KEY, or GEMINI_API_KEY.
GOOGLE_TTS_API_KEY=""
GOOGLE_CLOUD_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
